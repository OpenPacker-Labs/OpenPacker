{
  "name": "@openpacker/openpackerd",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "Fastify reference service for PREX",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openpackerd": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:e2e": "vitest run",
    "test:compat": "vitest run",
    "check:contracts": "vitest run",
    "check:generated": "vitest run"
  },
  "dependencies": {
    "@openpacker/adapter-core": "0.0.1-alpha.1",
    "@openpacker/adapter-host": "0.0.1-alpha.1",
    "@openpacker/adapters-default": "0.0.1-alpha.1",
    "@openpacker/artifact-model": "0.0.1-alpha.1",
    "@openpacker/artifact-store": "0.0.1-alpha.1",
    "@openpacker/canonical": "0.0.1-alpha.1",
    "@openpacker/conformance": "0.0.1-alpha.1",
    "@openpacker/contracts": "0.0.1-alpha.1",
    "@openpacker/embedded": "0.0.1-alpha.1",
    "@openpacker/events": "0.0.1-alpha.1",
    "@openpacker/lifecycle": "0.0.1-alpha.1",
    "@openpacker/lock-import": "0.0.1-alpha.1",
    "@openpacker/policy": "0.0.1-alpha.1",
    "@openpacker/receipts": "0.0.1-alpha.1",
    "@openpacker/trust": "0.0.1-alpha.1",
    "fastify": "5.11.2"
  },
  "devDependencies": {
    "@types/node": "24.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyler-R-Kendrick/OpenPacker.git",
    "directory": "apps/openpackerd"
  }
}
