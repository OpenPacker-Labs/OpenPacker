{
  "name": "@openpacker/opm",
  "version": "0.0.1-alpha.1",
  "description": "Open Package Manager CLI (opm) and package executor (opmx)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "opm": "./dist/main.js",
    "opmx": "./dist/opmx-main.js",
    "opkg": "./dist/main.js",
    "opkgm": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/opm.d.ts",
      "import": "./dist/opm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:e2e": "vitest run",
    "check:contracts": "vitest run",
    "check:generated": "vitest run"
  },
  "dependencies": {
    "@openpacker/adapter-core": "0.0.1-alpha.1",
    "@openpacker/adapters-default": "0.0.1-alpha.1",
    "@openpacker/canonical": "0.0.1-alpha.1",
    "@openpacker/opm-project": "0.0.1-alpha.1",
    "@openpacker/plugin-host": "0.0.1-alpha.1",
    "@openpacker/plugin-store": "0.0.1-alpha.1"
  },
  "devDependencies": {
    "@openpacker/packslip-testkit": "0.0.1-alpha.1",
    "@openpacker/sandbox": "0.0.1-alpha.1",
    "@types/node": "24.2.1"
  }
}
