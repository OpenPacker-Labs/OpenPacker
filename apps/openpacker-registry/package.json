{
  "name": "@openpacker/openpacker-registry",
  "version": "0.0.1-alpha.1",
  "description": "A PREX registry: serves package manifests over the registry HTTP binding",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "openpacker-registry": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
