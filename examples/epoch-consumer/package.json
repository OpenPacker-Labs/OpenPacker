{
  "name": "@openpacker/example-epoch-consumer",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "Neutral downstream consumer contract for Epoch",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:compat": "vitest run",
    "test:browser": "node --test test/sdk-browser.playwright.mjs",
    "test:pact:consumer": "vitest run test/pact.consumer.test.ts",
    "test:pact:chaos": "vitest run test/pact.chaos.test.ts",
    "test:pact:mutation": "vitest run test/pact.mutation.test.ts",
    "test:pact:provider": "node dist/src/pact-provider.js",
    "check:contracts": "vitest run",
    "check:generated": "vitest run"
  },
  "dependencies": {
    "@openpacker/canonical": "0.0.1-alpha.1",
    "@openpacker/conformance": "0.0.1-alpha.1",
    "@openpacker/contracts": "0.0.1-alpha.1",
    "@openpacker/embedded": "0.0.1-alpha.1",
    "@openpacker/events": "0.0.1-alpha.1",
    "@openpacker/receipts": "0.0.1-alpha.1",
    "@openpacker/sdk": "0.0.1-alpha.1",
    "@openpacker/trust": "0.0.1-alpha.1"
  },
  "devDependencies": {
    "@openpacker/openpackerd": "0.0.1-alpha.1",
    "@pact-foundation/pact": "17.1.4",
    "@types/node": "26.6.6",
    "playwright": "1.64.1"
  }
}
