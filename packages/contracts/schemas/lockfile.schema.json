{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpacker.dev/spec/prex/v1/schemas/lockfile.schema.json",
  "title": "openpacker.lock.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "protocolVersion",
    "rootRequirements",
    "target",
    "semanticsProfile",
    "objectiveOrdering",
    "selectedExactPurls",
    "dependencyEdges",
    "artifactDescriptors",
    "ocmReferences",
    "sourceSnapshotDigests",
    "lifecycleRoot",
    "policyDigest",
    "solutionDigest",
    "receiptDigest",
    "externalRefs"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "protocolVersion": { "const": "1.0-draft" },
    "rootRequirements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": { "$ref": "model.schema.json#/$defs/Requirement" }
    },
    "target": { "$ref": "model.schema.json#/$defs/TargetContext" },
    "semanticsProfile": {
      "enum": [
        "native-capture-v1",
        "native-validated-v1",
        "prex-calculus-subset-v1"
      ]
    },
    "objectiveOrdering": {
      "$ref": "resolution.schema.json#/$defs/SolveRequest/properties/objectives"
    },
    "selectedExactPurls": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^pkg:.*@", "maxLength": 8192 }
    },
    "dependencyEdges": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "resolution.schema.json#/$defs/DependencyEdge" }
    },
    "artifactDescriptors": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "model.schema.json#/$defs/ArtifactDescriptor" }
    },
    "ocmReferences": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "common.schema.json#/$defs/ExternalRef" }
    },
    "sourceSnapshotDigests": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    },
    "lifecycleRoot": { "$ref": "common.schema.json#/$defs/Digest" },
    "policyDigest": { "$ref": "common.schema.json#/$defs/Digest" },
    "solutionDigest": { "$ref": "common.schema.json#/$defs/Digest" },
    "receiptDigest": { "$ref": "common.schema.json#/$defs/Digest" },
    "externalRefs": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "common.schema.json#/$defs/ExternalRef" }
    },
    "platforms": { "$ref": "model.schema.json#/$defs/PlatformContexts" },
    "selectedOutputs": {
      "$comment": "Outputs pinned per selected package. Absent entries mean the default output.",
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["exactPurl", "outputs"],
        "properties": {
          "exactPurl": { "type": "string", "pattern": "^pkg:.*@" },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "model.schema.json#/$defs/OutputName" }
          }
        },
        "additionalProperties": false
      }
    },
    "recipeDigests": {
      "$comment": "build-recipe-v1 digests of the captured plans behind this lock.",
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    },
    "substitutes": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "model.schema.json#/$defs/SubstituteDescriptor" }
    },
    "environment": {
      "$comment": "The environment generation this lock was produced for, when it belongs to one.",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "environment.schema.json#/$defs/EnvironmentName" },
        "baseGenerationDigest": { "$ref": "common.schema.json#/$defs/Digest" }
      },
      "additionalProperties": false
    },
    "extensions": { "$ref": "common.schema.json#/$defs/Extensions" }
  },
  "additionalProperties": false
}
