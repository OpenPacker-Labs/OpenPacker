{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpacker.dev/spec/prex/v1/schemas/common.schema.json",
  "title": "PREX common types",
  "$defs": {
    "SafeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "CanonicalJsonValue": {
      "$comment": "PREX validators additionally enforce a maximum nesting depth of 64 and at most 1000000 total values per protocol document.",
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "$ref": "#/$defs/SafeInteger" },
        { "type": "string", "maxLength": 1048576 },
        {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/CanonicalJsonValue" }
        },
        {
          "type": "object",
          "maxProperties": 100000,
          "propertyNames": { "maxLength": 4096 },
          "additionalProperties": { "$ref": "#/$defs/CanonicalJsonValue" }
        }
      ]
    },
    "Extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
      "additionalProperties": { "$ref": "#/$defs/CanonicalJsonValue" }
    },
    "DigestProjection": {
      "type": "object",
      "required": [
        "id",
        "algorithm",
        "canonicalization",
        "includePaths",
        "excludePaths",
        "orderedSetPaths"
      ],
      "properties": {
        "id": {
          "enum": [
            "request-v1",
            "universe-v1",
            "package-node-v1",
            "metadata-record-v1",
            "solution-v1",
            "proof-v1",
            "explanation-v1",
            "artifact-set-v1",
            "receipt-v1",
            "event-data-v1",
            "tree-manifest-v1",
            "build-recipe-v1",
            "recipe-output-v1",
            "substitute-v1",
            "environment-manifest-v1",
            "environment-generation-v1",
            "closure-v1"
          ]
        },
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "prex-jcs-safe-integer-v1" },
        "includePaths": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:|/.*)$",
            "maxLength": 4096
          }
        },
        "excludePaths": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/.*", "maxLength": 4096 }
        },
        "orderedSetPaths": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/.*", "maxLength": 4096 }
        }
      },
      "additionalProperties": false
    },
    "Digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false,
      "examples": [
        {
          "algorithm": "sha256",
          "value": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        }
      ]
    },
    "DigestString": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "examples": [
        "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      ]
    },
    "IdentityRef": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "enum": ["uri", "key", "oidc", "spiffe", "did", "provider-specific"]
        },
        "value": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "issuer": { "type": "string", "maxLength": 2048 },
        "subject": { "type": "string", "maxLength": 2048 },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/ExternalRef" }
        },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "additionalProperties": false
    },
    "ExternalRef": {
      "type": "object",
      "required": ["type", "locator"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "digest": { "$ref": "#/$defs/Digest" },
        "mediaType": { "type": "string", "maxLength": 255 },
        "annotations": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "required": ["type", "uri"],
      "properties": {
        "type": {
          "enum": [
            "repository",
            "registry",
            "metadata",
            "overlay",
            "lockfile",
            "api"
          ]
        },
        "uri": { "type": "string", "format": "uri", "maxLength": 8192 },
        "revision": { "type": "string", "maxLength": 1024 },
        "digest": { "$ref": "#/$defs/Digest" },
        "path": { "type": "string", "maxLength": 4096 },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "additionalProperties": false
    },
    "SemanticLoss": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "sourceEcosystem",
        "sourcePath",
        "originalMeaning",
        "blocksProfile"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "sourceEcosystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sourcePath": { "type": "string", "maxLength": 4096 },
        "originalMeaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "representedMeaning": { "type": "string", "maxLength": 16384 },
        "omittedMeaning": { "type": "string", "maxLength": 16384 },
        "mitigation": { "type": "string", "maxLength": 16384 },
        "blocksProfile": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "native-capture-v1",
              "native-validated-v1",
              "prex-calculus-subset-v1",
              "derivation-capture-v1"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "Warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "path": { "type": "string", "maxLength": 4096 },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "additionalProperties": false
    },
    "ProtocolMeta": {
      "type": "object",
      "required": ["protocolVersion", "provider"],
      "properties": {
        "protocolVersion": { "const": "1.0-draft" },
        "provider": {
          "type": "object",
          "required": ["id", "implementation", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 255 },
            "implementation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "buildDigest": { "$ref": "#/$defs/Digest" }
          },
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/Warning" }
        },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "additionalProperties": false
    }
  }
}
