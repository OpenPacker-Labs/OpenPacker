{
  "name": "@openpacker/pack-provider",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "Manifest-backed delegated package builder host",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-package.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openpacker/adapter-core": "0.0.1-alpha.1",
    "@openpacker/canonical": "0.0.1-alpha.1",
    "@openpacker/conformance": "0.0.1-alpha.1",
    "@openpacker/contracts": "0.0.1-alpha.1",
    "@openpacker/project-io": "0.0.1-alpha.1",
    "@openpacker/sandbox": "0.0.1-alpha.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  }
}
