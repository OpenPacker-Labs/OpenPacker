{
  "name": "@openpacker/adapter-nix",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-package.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "OPENPACKER_LIVE_NIX=1 vitest run test/provider.live.test.ts"
  },
  "dependencies": {
    "@openpacker/adapter-core": "0.0.1-alpha.1",
    "@openpacker/canonical": "0.0.1-alpha.1",
    "@openpacker/contracts": "0.0.1-alpha.1",
    "@openpacker/sandbox": "0.0.1-alpha.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPacker-Labs/OpenPacker.git",
    "directory": "packages/adapter-nix"
  }
}
