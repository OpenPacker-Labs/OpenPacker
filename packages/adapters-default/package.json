{
  "name": "@openpacker/adapters-default",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "Default PREX adapter set registered into the adapter host",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-package.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openpacker/adapter-apt": "0.0.1-alpha.1",
    "@openpacker/adapter-cargo": "0.0.1-alpha.1",
    "@openpacker/adapter-chocolatey": "0.0.1-alpha.1",
    "@openpacker/adapter-core": "0.0.1-alpha.1",
    "@openpacker/adapter-golang": "0.0.1-alpha.1",
    "@openpacker/adapter-host": "0.0.1-alpha.1",
    "@openpacker/adapter-maven": "0.0.1-alpha.1",
    "@openpacker/adapter-nix": "0.0.1-alpha.1",
    "@openpacker/adapter-npm": "0.0.1-alpha.1",
    "@openpacker/adapter-nuget": "0.0.1-alpha.1",
    "@openpacker/adapter-packslip": "0.0.1-alpha.1",
    "@openpacker/adapter-pypi": "0.0.1-alpha.1",
    "@openpacker/adapter-winget": "0.0.1-alpha.1",
    "@openpacker/oci": "0.0.1-alpha.1",
    "@openpacker/project-io": "0.0.1-alpha.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@openpacker/materializer": "0.0.1-alpha.1",
    "@openpacker/packslip-testkit": "0.0.1-alpha.1",
    "@types/node": "24.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPacker-Labs/OpenPacker.git",
    "directory": "packages/adapters-default"
  }
}
