{
  "name": "@openpacker/opm-project",
  "version": "0.1.0",
  "description": "Open Package Manager project model: manifest, lock, store, install",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-package.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:e2e": "vitest run",
    "check:contracts": "vitest run",
    "check:generated": "vitest run"
  },
  "dependencies": {
    "@openpacker/adapter-core": "0.1.0",
    "@openpacker/adapter-host": "0.1.0",
    "@openpacker/artifact-model": "0.1.0",
    "@openpacker/canonical": "0.1.0",
    "@openpacker/contracts": "0.1.0",
    "@openpacker/embedded": "0.1.0",
    "@openpacker/materializer": "0.1.0",
    "@openpacker/pack-provider": "0.1.0",
    "@openpacker/policy": "0.1.0",
    "@openpacker/project-io": "0.1.0",
    "@openpacker/sandbox": "0.1.0",
    "@openpacker/sdk": "0.1.0",
    "shell-quote": "1.10.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@openpacker/adapters-default": "0.1.0",
    "@types/node": "24.2.1"
  }
}
