{
  "name": "@openpacker/adapter-packslip",
  "version": "0.0.1-alpha.0",
  "description": "PREX catalog provider for packslip-signed vendor releases",
  "type": "module",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-package.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openpacker/adapter-core": "0.0.1-alpha.0",
    "@openpacker/canonical": "0.0.1-alpha.0",
    "@openpacker/contracts": "0.0.1-alpha.0",
    "@openpacker/packslip": "0.0.1-alpha.0"
  },
  "devDependencies": {
    "@openpacker/packslip-testkit": "0.0.1-alpha.0",
    "@types/node": "24.2.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyler-R-Kendrick/OpenPacker.git",
    "directory": "packages/adapter-packslip"
  }
}
