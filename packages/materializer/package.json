{
  "name": "@openpacker/materializer",
  "version": "0.1.0",
  "description": "Bounded, digest-verified, atomic native package materialization",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:security": "vitest run",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@openpacker/adapter-core": "0.1.0",
    "@openpacker/artifact-model": "0.1.0",
    "@openpacker/canonical": "0.1.0",
    "@openpacker/contracts": "0.1.0",
    "@openpacker/project-io": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.2.1"
  }
}
