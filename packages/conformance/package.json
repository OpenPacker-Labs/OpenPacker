{
  "name": "@openpacker/conformance",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "Executable PREX conformance validators and vectors",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:conformance": "vitest run",
    "test:security": "vitest run",
    "test:integration": "vitest run",
    "test:e2e": "vitest run",
    "test:compat": "vitest run",
    "test:browser": "vitest run",
    "check:contracts": "vitest run test/contracts.test.ts",
    "check:generated": "npm run check:generated -w @openpacker/contracts"
  },
  "dependencies": {
    "@openpacker/canonical": "0.0.1-alpha.1",
    "@openpacker/contracts": "0.0.1-alpha.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPacker-Labs/OpenPacker.git",
    "directory": "packages/conformance"
  }
}
