{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpacker.dev/spec/prex/v1/schemas/delegated-pack-provider.schema.json",
  "title": "PREX delegated pack provider manifest and host plan",
  "$defs": {
    "DelegatedProviderId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "DelegatedProviderPurlType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9+.-]*$"
    },
    "PackProviderEnvironmentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "PackProviderTemplate": {
      "$comment": "No shell expansion. Hosts replace only the closed token vocabulary, directly into argv or environment values.",
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^(?:[^{}]|\\{(?:executable|projectRoot|manifestPath|outputDirectory|packageName|packageVersion)\\})+$"
    },
    "PackProviderCondition": {
      "enum": [
        "always",
        "allow-build",
        "deny-build",
        "allow-network",
        "offline"
      ]
    },
    "PackProviderArgument": {
      "oneOf": [
        { "$ref": "#/$defs/PackProviderTemplate" },
        {
          "type": "object",
          "required": ["value", "when"],
          "properties": {
            "value": { "$ref": "#/$defs/PackProviderTemplate" },
            "when": { "$ref": "#/$defs/PackProviderCondition" }
          },
          "additionalProperties": false
        }
      ]
    },
    "PackProviderCommandTemplate": {
      "type": "object",
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/PackProviderArgument" }
        }
      },
      "additionalProperties": false
    },
    "PackProviderDetection": {
      "type": "object",
      "required": ["manifestNames"],
      "properties": {
        "manifestNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?![.]{1,2}$)(?!.*[\\\\/]).+$"
          }
        }
      },
      "additionalProperties": false
    },
    "DelegatedProviderAuthority": {
      "$comment": "Authority is a request, never a grant. The host separately requires user consent and sandbox enforcement.",
      "type": "object",
      "required": ["build", "network", "environment"],
      "properties": {
        "build": { "type": "boolean" },
        "network": { "enum": ["never", "consent"] },
        "environment": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/PackProviderEnvironmentName" }
        }
      },
      "additionalProperties": false
    },
    "PackProviderArtifactFields": {
      "type": "object",
      "required": ["mediaType", "nativeRole"],
      "properties": {
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "nativeRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "PackProviderArtifactPattern": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/PackProviderArtifactFields" },
            {
              "type": "object",
              "required": ["suffix"],
              "properties": {
                "suffix": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "^[.][A-Za-z0-9._+-]+$"
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/PackProviderArtifactFields" },
            {
              "type": "object",
              "required": ["basename"],
              "properties": {
                "basename": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "^(?![.]{1,2}$)(?!.*[\\\\/]).+$"
                }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "DelegatedPackProviderManifest": {
      "type": "object",
      "required": [
        "delegatedPackProviderVersion",
        "id",
        "purlTypes",
        "detection",
        "executable",
        "commands",
        "authority",
        "artifacts"
      ],
      "properties": {
        "$schema": { "type": "string", "format": "uri" },
        "delegatedPackProviderVersion": { "const": "1" },
        "id": { "$ref": "#/$defs/DelegatedProviderId" },
        "displayName": { "type": "string", "maxLength": 255 },
        "purlTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/DelegatedProviderPurlType" }
        },
        "detection": { "$ref": "#/$defs/PackProviderDetection" },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/PackProviderCommandTemplate" }
        },
        "cleanupCommands": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/PackProviderCommandTemplate" }
        },
        "environment": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "$ref": "#/$defs/PackProviderEnvironmentName" },
          "additionalProperties": { "$ref": "#/$defs/PackProviderTemplate" }
        },
        "authority": { "$ref": "#/$defs/DelegatedProviderAuthority" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/PackProviderArtifactPattern" }
        }
      },
      "additionalProperties": false
    },
    "DelegatedPackHostPlan": {
      "$comment": "Canonical JSON returned by a package-build WIT guest or by compiling a provider manifest. The host authorizes and executes it.",
      "type": "object",
      "required": [
        "providerId",
        "purlType",
        "executable",
        "commands",
        "cleanupCommands",
        "environment",
        "authority",
        "artifacts"
      ],
      "properties": {
        "providerId": { "$ref": "#/$defs/DelegatedProviderId" },
        "purlType": { "$ref": "#/$defs/DelegatedProviderPurlType" },
        "executable": { "type": "string", "minLength": 1, "maxLength": 255 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": { "type": "string", "maxLength": 8192 }
          }
        },
        "cleanupCommands": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": { "type": "string", "maxLength": 8192 }
          }
        },
        "environment": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": { "$ref": "#/$defs/PackProviderEnvironmentName" },
          "additionalProperties": { "type": "string", "maxLength": 1048576 }
        },
        "authority": { "$ref": "#/$defs/DelegatedProviderAuthority" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/PackProviderArtifactPattern" }
        }
      },
      "additionalProperties": false
    }
  }
}
