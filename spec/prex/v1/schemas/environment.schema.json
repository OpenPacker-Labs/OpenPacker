{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpacker.dev/spec/prex/v1/schemas/environment.schema.json",
  "title": "PREX environment manifests, generations, and state",
  "$defs": {
    "EnvironmentName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "EnvironmentManifest": {
      "$comment": "The declarative input to an environment: what it should contain, for which platforms, under which policy. environment-manifest-v1 projection digest identifies it.",
      "type": "object",
      "required": ["manifestVersion", "name", "requirements", "target"],
      "properties": {
        "manifestVersion": { "const": "1" },
        "name": { "$ref": "#/$defs/EnvironmentName" },
        "description": { "type": "string", "maxLength": 1024 },
        "requirements": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "model.schema.json#/$defs/Requirement" }
        },
        "target": { "$ref": "model.schema.json#/$defs/TargetContext" },
        "platforms": { "$ref": "model.schema.json#/$defs/PlatformContexts" },
        "policy": { "$ref": "resolution.schema.json#/$defs/PolicyInput" },
        "extensions": { "$ref": "common.schema.json#/$defs/Extensions" }
      },
      "additionalProperties": false
    },
    "EnvironmentMember": {
      "type": "object",
      "required": ["artifactDigest"],
      "properties": {
        "nodeId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "exactPurl": {
          "type": "string",
          "pattern": "^pkg:[a-z0-9.+-]+/",
          "maxLength": 8192
        },
        "artifactDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "treeDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "outputs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "model.schema.json#/$defs/OutputName" }
        }
      },
      "additionalProperties": false
    },
    "EnvironmentGeneration": {
      "$comment": "An immutable record of one environment state. Generations are append-only and hash-linked through parentGenerationDigest; generationDigest is the environment-generation-v1 projection digest, which excludes itself.",
      "type": "object",
      "required": [
        "generationVersion",
        "environmentName",
        "sequence",
        "createdAt",
        "manifestDigest",
        "artifactSet",
        "generationDigest"
      ],
      "properties": {
        "generationVersion": { "const": "1" },
        "environmentName": { "$ref": "#/$defs/EnvironmentName" },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "parentGenerationDigest": {
          "$comment": "Absent only for the first generation of an environment.",
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "manifestDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "lockfileDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "solutionDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "receiptDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "artifactSet": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/EnvironmentMember" }
        },
        "semanticLoss": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "common.schema.json#/$defs/SemanticLoss" }
        },
        "generationDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "extensions": { "$ref": "common.schema.json#/$defs/Extensions" }
      },
      "additionalProperties": false
    },
    "EnvironmentState": {
      "$comment": "The single mutable pointer for an environment. Switching and rolling back replace this record atomically; generation records themselves are never rewritten. Retained generations are the reachability roots for collection.",
      "type": "object",
      "required": [
        "stateVersion",
        "environmentName",
        "currentGenerationDigest",
        "retainedGenerationDigests"
      ],
      "properties": {
        "stateVersion": { "const": "1" },
        "environmentName": { "$ref": "#/$defs/EnvironmentName" },
        "currentGenerationDigest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "retainedGenerationDigests": {
          "$comment": "MUST contain currentGenerationDigest.",
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "common.schema.json#/$defs/Digest" }
        },
        "extensions": { "$ref": "common.schema.json#/$defs/Extensions" }
      },
      "additionalProperties": false
    }
  }
}
