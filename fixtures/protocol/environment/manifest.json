{
  "manifestVersion": "1",
  "name": "devshell",
  "description": "Toolchain and libraries for working on libgreet",
  "requirements": [
    {
      "id": "root-tool",
      "expression": {
        "type": "package",
        "purl": "pkg:npm/%40openpacker/demo-tool",
        "vers": "vers:npm/>=1.0.0|<2.0.0"
      },
      "kind": "runtime",
      "optional": false,
      "source": {
        "type": "overlay",
        "uri": "https://openpacker.dev/fixtures/root"
      },
      "authority": "test-fixture",
      "semanticLoss": []
    }
  ],
  "target": {
    "os": "linux",
    "architecture": "arm64",
    "libc": "glibc",
    "runtimes": {
      "node": "24"
    },
    "capabilities": [
      {
        "name": "cpu:arm64"
      },
      {
        "name": "runtime:node",
        "version": "24"
      }
    ]
  },
  "policy": {
    "allowYanked": false,
    "allowQuarantined": false,
    "semanticLossMaximum": "warning",
    "requiredEvidence": ["receipt-signature"],
    "acceptedOverlayAuthorities": ["publisher", "test-fixture"]
  }
}
