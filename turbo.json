{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "envMode": "strict",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": [
    "CARGO_HOME",
    "RUSTUP_HOME",
    "CARGO_TARGET_DIR",
    "CARGO_INCREMENTAL",
    "CARGO_BUILD_JOBS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "@openpacker/embedded#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "OPENPACKER_REQUIRE_WASM"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**"],
      "outputs": ["coverage/**"]
    },
    "check:contracts": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:generated": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:conformance": { "dependsOn": ["build"], "outputs": [] },
    "test:security": { "dependsOn": ["build"], "outputs": [] },
    "test:integration": { "dependsOn": ["build"], "outputs": [] },
    "test:e2e": { "dependsOn": ["build"], "outputs": [] },
    "test:compat": { "dependsOn": ["build"], "outputs": [] },
    "test:browser": { "dependsOn": ["build"], "outputs": [] }
  }
}
