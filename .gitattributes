# Normalize text files to LF so rustfmt newline_style = "Unix" is stable on Windows CI.
* text=auto eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.lock text eol=lf
*.crate binary
*.tgz binary
*.whl binary
*.zip binary
*.nupkg binary
*.node binary
