# Normalize text files to LF so rustfmt newline_style = "Unix" is stable on Windows CI.
* text=auto eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.lock text eol=lf
# cmd.exe reads a batch file's lines by CRLF; the opm run shims keep it (ADR 0061).
apps/opm/shims/bin/*.cmd text eol=crlf
*.crate binary
*.tgz binary
*.whl binary
*.zip binary
*.nupkg binary
*.node binary
