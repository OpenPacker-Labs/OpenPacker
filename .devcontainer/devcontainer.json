{
  "name": "OpenPacker",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "dbaeumer.vscode-eslint"]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/dotfiles:1": {
      "repository": "OpenPacker-Labs/dotfiles",
      "targetPath": "/home/vscode/dotfiles"
    }
  },
  "postCreateCommand": "bash /home/vscode/dotfiles/install.sh && npm ci --ignore-scripts",
  "forwardPorts": []
}
